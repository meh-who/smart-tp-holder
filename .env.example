# Copy to .env and fill in. Run with: node --env-file=.env server/index.js

PORT=8080
# Public address of this server. OAuth redirect URIs are built from it.
PUBLIC_URL=http://localhost:8080
# Shared secret the holder sends when it connects.
DEVICE_KEY=change-me
# Comma-separated holder ids. Each NFC tag opens <PUBLIC_URL>/?h=<id>
HOLDER_IDS=roll-1
# Visitor accounts are kept in memory only and forgotten after this many idle minutes.
AUTH_TTL_MINUTES=30
# 1 = services connect without real OAuth and read invented text. For rehearsals.
DEMO=0

# News: any RSS feeds, comma-separated.
NEWS_FEEDS=https://feeds.bbci.co.uk/news/world/rss.xml,https://rss.nytimes.com/services/xml/rss/nyt/HomePage.xml

# X developer app (OAuth 2.0). Callback: <PUBLIC_URL>/auth/x/callback
X_CLIENT_ID=
X_CLIENT_SECRET=

# TikTok Login Kit. Redirect: <PUBLIC_URL>/auth/tiktok/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Instagram API with Instagram Login. Redirect: <PUBLIC_URL>/auth/instagram/callback
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
