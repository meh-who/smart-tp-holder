# Copy to .env and `set -a; . ./.env; set +a` before starting, or pass to Docker with --env-file.
PUBLIC_URL=https://holder.example.org        # what the NFC tag points at; must be HTTPS for OAuth callbacks
SECRET_KEY=change-me-to-a-long-random-string
HOLDER_POLL_S=20

# Text to speech: edge (free) | openai | espeak (offline dev)
TTS_PROVIDER=edge
EDGE_VOICE=en-GB-SoniaNeural
#OPENAI_API_KEY=
#OPENAI_TTS_MODEL=gpt-4o-mini-tts
#OPENAI_TTS_VOICE=alloy

# News: comma-separated RSS feeds
NEWS_FEEDS=https://feeds.bbci.co.uk/news/world/rss.xml,https://www.theguardian.com/world/rss

# OAuth apps (leave blank to hide the Connect button for that service)
X_CLIENT_ID=
X_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
IG_APP_ID=
IG_APP_SECRET=
